<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<title>مدير المهام</title>

<style>
body {
  font-family: Arial;
  background: #0f172a;
  color: white;
  text-align: center;
}

.container {
  max-width: 700px;
  margin: auto;
  padding: 20px;
}

.input-group {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

input, select {
  padding: 10px;
  border-radius: 8px;
  border: none;
}

button {
  background: #3b82f6;
  color: white;
  border: none;
  padding: 10px;
  border-radius: 8px;
  cursor: pointer;
}

.task {
  background: #1e293b;
  padding: 15px;
  margin: 10px 0;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.checks {
  margin-top: 8px;
}

.checks input {
  margin: 3px;
  transform: scale(1.2);
}

.delete {
  background: red;
}
</style>
</head>

<body>

<div class="container">
  <h1>📋 مدير المهام</h1>

  <div class="input-group">
    <input id="taskInput" placeholder="اكتب المهمة..." />

    <select id="taskType">
      <option value="daily">يومية</option>
      <option value="weekly">أسبوعية</option>
      <option value="monthly">شهرية</option>
      <option value="yearly">سنوية</option>
    </select>

    <!-- عدد التكرارات -->
    <input id="repeatCount" type="number" min="1" value="1" style="width:70px" />

    <button onclick="addTask()">إضافة</button>
  </div>

  <div id="taskList"></div>
</div>

<script>
let tasks = JSON.parse(localStorage.getItem("tasks")) || [];

function saveTasks() {
  localStorage.setItem("tasks", JSON.stringify(tasks));
}

function addTask() {
  const text = document.getElementById("taskInput").value;
  const type = document.getElementById("taskType").value;
  const repeat = parseInt(document.getElementById("repeatCount").value) || 1;

  if (!text) return;

  tasks.push({
    text,
    type,
    repeat,
    progress: Array(repeat).fill(false)
  });

  document.getElementById("taskInput").value = "";

  saveTasks();
  renderTasks();
}

function renderTasks() {
  const list = document.getElementById("taskList");
  list.innerHTML = "";

  tasks.forEach((task, index) => {
    const div = document.createElement("div");
    div.className = "task";

    let checksHTML = "";

    for (let i = 0; i < task.repeat; i++) {
      checksHTML += `
        <input type="checkbox"
          ${task.progress[i] ? "checked" : ""}
          onchange="toggleProgress(${index}, ${i})"
        />
      `;
    }

    div.innerHTML = `
      <div>
        <strong>${task.text}</strong>
        <div class="checks">${checksHTML}</div>
      </div>
      <button class="delete" onclick="deleteTask(${index})">🗑</button>
    `;

    list.appendChild(div);
  });
}

function toggleProgress(taskIndex, repeatIndex) {
  tasks[taskIndex].progress[repeatIndex] =
    !tasks[taskIndex].progress[repeatIndex];

  saveTasks();
}

function deleteTask(index) {
  tasks.splice(index, 1);
  saveTasks();
  renderTasks();
}

renderTasks();
</script>

</body>
</html>
